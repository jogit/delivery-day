<?xml version="1.0" encoding="utf-8"?>
<!-- Widget meant to be read at a glance: when? anything new? where are we? -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center_vertical"
    android:paddingStart="18dp" android:paddingEnd="14dp" android:paddingTop="12dp" android:paddingBottom="14dp"
    android:background="@drawable/widget_bg">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:layout_width="20dp" android:layout_height="20dp"
            android:src="@drawable/ic_car" android:tint="@color/tesla_red" android:contentDescription="@null" />
        <TextView android:id="@+id/w_model" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:layout_marginStart="8dp"
            android:textColor="@color/muted" android:textSize="14sp" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/w_updated" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:textColor="@color/muted" android:textSize="12sp" android:alpha="0.7" android:maxLines="1" />
        <ImageView android:id="@+id/w_refresh" android:layout_width="36dp" android:layout_height="36dp"
            android:padding="8dp" android:background="@drawable/widget_refresh_bg"
            android:src="@drawable/ic_refresh" android:tint="@color/text"
            android:contentDescription="@string/action_refresh" />
    </LinearLayout>

    <TextView android:id="@+id/w_window" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/text" android:textSize="24sp" android:textStyle="bold" android:maxLines="2" />

    <TextView android:id="@+id/w_countdown" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textColor="@color/amber" android:textSize="17sp" android:maxLines="1" />

    <TextView android:id="@+id/w_news" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="10dp" android:paddingStart="12dp" android:paddingEnd="12dp"
        android:paddingTop="7dp" android:paddingBottom="7dp"
        android:background="@drawable/widget_news_quiet"
        android:textColor="@color/muted" android:textSize="16sp" android:maxLines="2" android:ellipsize="end" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/w_steps" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content"
            android:textColor="@color/muted" android:textSize="14sp" android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>
</LinearLayout>
